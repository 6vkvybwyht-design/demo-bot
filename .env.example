# Токен бота від @BotFather
BOT_TOKEN=123456:replace-me
# Telegram ID власників через кому
ADMIN_IDS=111111111,222222222
# Демо-режим (true/false)
DEMO_MODE=true
# Рядок підключення до БД (SQLAlchemy async)
DATABASE_URL=sqlite+aiosqlite:///data/bot.db
# Бекап бази SQLite: куди складати копії й скільки останніх зберігати
BACKUP_DIR=data/backups
BACKUP_KEEP=7
# Файл логу (для запуску на Windows). У Docker залиште порожнім — логи в docker compose logs
LOG_FILE=
